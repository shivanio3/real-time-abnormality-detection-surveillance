# Email Configuration
# Get Gmail App Password from: https://myaccount.google.com/apppasswords
# DO NOT use your regular Gmail password

SENDER_EMAIL=your_email@gmail.com
SENDER_PASS=your_app_password_here
RECEIVER_EMAIL=recipient@example.com

# Optional: Multiple recipients (comma-separated)
# RECEIVER_EMAIL=recipient1@example.com,recipient2@example.com

# Detection Thresholds (0-100)
# Higher values = fewer detections but fewer false positives
# Lower values = more detections but more false positives

VIOLENCE_THRESHOLD=65
FIRE_THRESHOLD=65
FALL_THRESHOLD=60

# Alert Cooldown (seconds)
# Minimum time between alerts of the same type
ALERT_COOLDOWN=90

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Video Configuration
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=30

# Processing Configuration
# Process every Nth frame (1=every frame, 3=every 3rd frame)
FRAME_SKIP=3
MAX_UPLOAD_SIZE_MB=500

# GPU Configuration
# Set to 'cuda' for GPU acceleration, 'cpu' for CPU only
DEVICE=cuda
